#include <winres.h>
#include "resource.h"

IDI_MICPATCH ICON "micpatch.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,1,0
 PRODUCTVERSION 0,1,1,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "MicPatch\0"
            VALUE "FileVersion", "0.1.1\0"
            VALUE "OriginalFilename", "MicPatch.exe\0"
            VALUE "ProductName", "MicPatch\0"
            VALUE "ProductVersion", "0.1.1\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

IDD_SETTINGS DIALOGEX 0, 0, 304, 182
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Microsoft YaHei UI", 400, 0, 1
BEGIN
    LTEXT           "", IDC_SETTINGS_LANGUAGE_LABEL, 12, 14, 96, 12
    COMBOBOX        IDC_SETTINGS_LANGUAGE, 115, 11, 177, 74, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_SETTINGS_THEME_LABEL, 12, 34, 96, 12
    COMBOBOX        IDC_SETTINGS_THEME, 115, 31, 177, 74, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_SETTINGS_HOTKEY_LABEL, 12, 54, 96, 12
    COMBOBOX        IDC_SETTINGS_HOTKEY, 115, 51, 177, 74, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "", IDC_SETTINGS_REMEMBER, 12, 74, 280, 13, WS_TABSTOP
    AUTOCHECKBOX    "", IDC_SETTINGS_AUTOSAVE, 12, 91, 280, 13, WS_TABSTOP
    AUTOCHECKBOX    "", IDC_SETTINGS_START_MUTED, 12, 108, 280, 13, WS_TABSTOP
    LTEXT           "", IDC_SETTINGS_NOTE, 12, 129, 280, 25
    DEFPUSHBUTTON   "", IDOK, 172, 159, 56, 14
    PUSHBUTTON      "", IDCANCEL, 236, 159, 56, 14
END
